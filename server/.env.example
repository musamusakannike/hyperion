NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/hyperion
CLIENT_ORIGINS=http://localhost:3000

JWT_SECRET=change-me-to-a-long-random-string
